#!/bin/bash
# Echo local service controls.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/bin/language.sh"
echo_select_language "$ROOT"

LABEL="com.echo.chat"
MENUBAR_LABEL="com.echo.menubar"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
MENUBAR_PLIST="$HOME/Library/LaunchAgents/$MENUBAR_LABEL.plist"
PORT="${ECHO_PORT:-8787}"
URL="http://127.0.0.1:$PORT"
UID_NUM="$(id -u)"

c_ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
c_warn() { printf '\033[33m%s\033[0m\n' "$*"; }
c_err()  { printf '\033[31m%s\033[0m\n' "$*" >&2; return 1; }

need_plist() {
  if [ ! -f "$PLIST" ]; then
    c_err "$(msg need_launchd)"
    exit 1
  fi
}

need_dependencies() {
  if ! ( cd "$ROOT" && node --input-type=module -e "await import('@modelcontextprotocol/sdk/client/index.js')" >/dev/null 2>&1 ); then
    c_err "$(msg need_dependencies)"
    exit 1
  fi
}

local_token() {
  [ -f "${ECHO_DATA_DIR:-$ROOT/data}/local.token" ] && cat "${ECHO_DATA_DIR:-$ROOT/data}/local.token" || echo ""
}

api() { # A dash reads sensitive request bodies from stdin.
  local method="$1" path="$2" body="${3:-}"
  local tok; tok="$(local_token)"
  if [ "$body" = "-" ]; then
    curl -fsS -m "${ECHO_API_TIMEOUT:-300}" -X "$method" "$URL/api/$path" \
      -H 'content-type: application/json' -H 'x-echo-request: echo' -H "x-echo-local: $tok" --data-binary @-
  elif [ -n "$body" ]; then
    curl -fsS -m "${ECHO_API_TIMEOUT:-300}" -X "$method" "$URL/api/$path" \
      -H 'content-type: application/json' -H 'x-echo-request: echo' -H "x-echo-local: $tok" -d "$body"
  else
    curl -fsS -m "${ECHO_API_TIMEOUT:-60}" -X "$method" "$URL/api/$path" -H "x-echo-local: $tok"
  fi
}

format() { node "$ROOT/bin/cli-format.mjs" "$1" "$ECHO_DISPLAY_LANGUAGE"; }

case "${1:-status}" in
  up)
    need_plist
    need_dependencies
    launchctl bootstrap "gui/$UID_NUM" "$PLIST" 2>/dev/null || launchctl kickstart -k "gui/$UID_NUM/$LABEL"
    [ -f "$MENUBAR_PLIST" ] && launchctl bootstrap "gui/$UID_NUM" "$MENUBAR_PLIST" 2>/dev/null
    sleep 1.2
    "$0" status
    ;;
  down)
    need_plist
    launchctl bootout "gui/$UID_NUM/$LABEL" 2>/dev/null && c_warn "$(msg service_stopped)"
    launchctl bootout "gui/$UID_NUM/$MENUBAR_LABEL" 2>/dev/null || true
    ;;
  restart)
    need_plist
    need_dependencies
    launchctl kickstart -k "gui/$UID_NUM/$LABEL"
    sleep 1.2 && "$0" status
    ;;
  status)
    printf '%-14s' "$(msg process)"
    if pgrep -f "node .*server\.mjs" >/dev/null; then c_ok "$(msg running)"; else c_err "$(msg offline)"; fi
    printf '%-14s' "$(msg health)"
    if health="$(curl -sf -m 4 "$URL/api/health")"; then
      c_ok "$(msg responding "$URL")"
      format health <<< "$health"
      api GET summary | format summary
    else
      c_err "$(msg unreachable "$URL")"
    fi
    ;;
  logs)
    shift
    tail -n "${1:-40}" -f "$ROOT/data/logs/echo.out.log" "$ROOT/data/logs/echo.err.log" 2>/dev/null || \
      tail -n "${1:-40}" "$ROOT/data/logs/"*.log
    ;;
  open)
    open "$URL"
    ;;
  dream)
    c_warn "$(msg dream_start)"
    api POST dream '{}' | format dream || c_err "$(msg dream_failed)"
    ;;
  say)
    c_warn "$(msg checking)"
    api POST proactive/run '{}' | format say || c_err "$(msg request_failed)"
    ;;
  search)
    shift
    printf '%s' "${1:-$(msg default_query)}" | python3 -c 'import sys,json; sys.stdout.write(json.dumps({"query": sys.stdin.read()}))' \
      | api POST search/test - | format search || c_err "$(msg search_failed)"
    ;;
  mcp)
    api POST mcp/reload '{}' | format mcp
    ;;
  passwd)
    CURRENT=""
    if [ "$(api GET bootstrap 2>/dev/null | node -e 'try { const a = JSON.parse(require("node:fs").readFileSync(0, "utf8")).config.auth; process.stdout.write(String(a.required && a.passwordSet)) } catch {}')" = "true" ]; then
      printf '%s' "$(msg current_password)"; read -rs CURRENT; echo
    fi
    printf '%s' "$(msg new_password)"; read -rs NEW; echo
    printf '%s\0%s' "$CURRENT" "$NEW" | node -e 'const [current, password] = require("node:fs").readFileSync(0, "utf8").split("\0"); process.stdout.write(JSON.stringify({ current, password }))' \
      | api POST password - >/dev/null && c_ok "$(msg password_updated)"
    ;;
  auth)
    case "${2:-status}" in
      on)
        api PATCH auth '{"required":true}' >/dev/null && c_ok "$(msg auth_on)"
        ;;
      off)
        api PATCH auth '{"required":false}' >/dev/null && c_ok "$(msg auth_off)"
        ;;
      *)
        api GET bootstrap | format auth || c_err "$(msg read_failed)"
        ;;
    esac
    ;;
  init)
    "$ROOT/install.sh"
    ;;
  env)
    if [ -f "$ROOT/data/echo.env" ]; then
      c_ok "$(msg env_keys)"
      sed -nE 's/^([A-Za-z_][A-Za-z_0-9]*)=.*/  \1/p' "$ROOT/data/echo.env"
    else
      c_warn "$(msg env_missing)"
    fi
    ;;
  selftest)
    shift
    need_dependencies
    for arg in "$@"; do
      if [ "$arg" = "--json" ]; then exec node "$ROOT/tests/selftest.mjs" "$@"; fi
    done
    node "$ROOT/tests/selftest.mjs" "$@" --json | format selftest
    ;;
  forget)
    api GET memory/forgetting | format forget || c_err "$(msg read_failed)"
    ;;
  remember)
    shift
    printf '%s' "$*" | python3 -c 'import sys,json; sys.stdout.write(json.dumps({"text": sys.stdin.read(), "kind": "fact", "importance": 3}))' \
      | api POST memory/observation - >/dev/null && c_ok "$(msg remembered "$*")"
    ;;
  diag)
    api GET diagnostics | format diag || c_err "$(msg diag_failed)"
    ;;
  *)
    echo "$(msg usage)"
    ;;
esac
