{
  "name": "echo-assistant",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "跑在自己 Mac 上的私人对话窗口：零第三方依赖、分层记忆、可解释遗忘、主动服务、屏幕感知",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "selftest": "node tests/selftest.mjs",
    "selftest:live": "node tests/selftest.mjs --live",
    "menubar:build": "swiftc -O -o build/EchoBar menubar/main.swift menubar/EchoBar.swift menubar/CompanionOverlay.swift",
    "install:daemon": "./install.sh",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lazarus-coder/echo-assistant.git"
  },
  "dependencies": {},
  "devDependencies": {}
}
